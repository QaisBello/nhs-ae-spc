	partition Entities = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        Web.Contents(BaseUrl, [RelativePath = "spc_summary.csv"]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty cells and R's NA arrive as text and would fail the type change: make them null
				    #"Blanks to Null" = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" or _ = "NA" then null else _),
				    #"Changed Types" = Table.TransformColumnTypes(
				        #"Blanks to Null",
				        {
				            {"level", type text},
				            {"code", type text},
				            {"name", type text},
				            {"region", type text},
				            {"pct_4hr_variation", type text},
				            {"pct_4hr_special_6m", Int64.Type},
				            {"pct_4hr_assurance", type text},
				            {"pct_4hr_mean", type number},
				            {"pct_4hr_lpl", type number},
				            {"pct_4hr_upl", type number},
				            {"dta_12hr_plus_variation", type text}
				        },
				        "en-US"
				    ),
				    #"Filtered Rows" = #"Changed Types",
				    #"Variation" = Table.AddColumn(#"Filtered Rows", "Variation", each
				        if [pct_4hr_variation] = "improvement" then "Special cause: improving"
				        else if [pct_4hr_variation] = "concern" then "Special cause: concern"
				        else "Common cause", type text),
				    #"Assurance" = Table.AddColumn(#"Variation", "Assurance", each
				        if [pct_4hr_assurance] = "pass" then "Will consistently meet 82%"
				        else if [pct_4hr_assurance] = "fail" then "Will consistently miss 82%"
				        else "Hit and miss", type text),
				    #"Level Order" = Table.AddColumn(#"Assurance", "Level Order", each
				        if [level] = "England" then 1 else if [level] = "Region" then 2 else 3, Int64.Type),
				    Result = #"Level Order"
				in
				    Result

